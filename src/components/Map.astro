---

const TILES = [
	["/tiles/vichy/15-16695-11640.png", "/tiles/vichy/15-16696-11640.png"],
	["/tiles/vichy/15-16695-11641.png", "/tiles/vichy/15-16696-11641.png"],
];
---

<div class="app-map" _ngcontent-ng-c2150733359="" _nghost-ng-c1575046755="">
    <div _ngcontent-ng-c1575046755="" class="map-container">
        <div _ngcontent-ng-c1575046755="" class="section-header">
            <img
                _ngcontent-ng-c1575046755=""
                src="/icons/map.svg"
                class="section-icon"
                alt="Map icon"
            /><h2 _ngcontent-ng-c1575046755="" class="section-title">MAP</h2>
        </div>
        <a
            _ngcontent-ng-c1575046755=""
            class="map-static"
            href="https://www.openstreetmap.org/?mlat=46.1271&amp;mlon=3.4261#map=16/46.1271/3.4261"
            target="_blank"
            rel="noopener noreferrer"
            title="Open Vichy in OpenStreetMap"
        >
            {TILES.map((row) => (
                <div class="map-static-row">
                    {row.map((tile) => (
                        <img
                            class="map-static-tile"
                            src={tile}
                            alt=""
                        />
                    ))}
                </div>
            ))}
            <span class="map-pin" aria-hidden="true"></span>
            <span class="map-attribution"
                >© OpenStreetMap © CARTO</span
            >
        </a>
    </div>
</div>

<style>
    :global(.column-2 > .app-map) {
        flex: 0 0 auto;
    }

    .map-static {
        position: relative;
        display: block;
        overflow: hidden;
        flex-shrink: 0;
        width: 100%;
        aspect-ratio: 1 / 1;
    }

    .map-static-row {
        display: flex;
        width: 100%;
        height: 50%;
    }

    .map-static-row:last-child {
        margin-top: -2px;
    }

    .map-static-tile {
        width: 50%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: var(--map-tile-filter);
    }

    .map-pin {
        position: absolute;
        left: 42.5%;
        top: 46.5%;
        width: 26px;
        height: 26px;
        border-radius: 50% 50% 50% 0;
        background: var(--map-marker-bg);
        border: 3px solid var(--map-marker-muted-bg);
        transform: translate(-50%, -50%) rotate(-45deg);
        box-shadow: var(--map-marker-shadow);
    }

    .map-pin::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--text-danger);
        transform: translate(-50%, -50%);
    }

    .map-attribution {
        position: absolute;
        right: 4px;
        bottom: 4px;
        padding: 2px 5px;
        border-radius: 4px;
        font-size: 8px;
        color: var(--text-faint);
        background: color-mix(
            in srgb,
            var(--surface-page) 70%,
            transparent
        );
        pointer-events: none;
    }
</style>
