<div class="app-map" _ngcontent-ng-c2150733359="" _nghost-ng-c1575046755="">
    <div _ngcontent-ng-c1575046755="" class="map-container">
        <div _ngcontent-ng-c1575046755="" class="section-header">
            <img
                _ngcontent-ng-c1575046755=""
                src="/icons/map.svg"
                class="section-icon"
                alt="Map icon"
            /><h2 _ngcontent-ng-c1575046755="" class="section-title">MAP</h2>
        </div>
        <div
            class="map-leaflet"
            data-map
            role="application"
            aria-label="Interactive map of Vichy — drag to move, buttons to zoom"
        ></div>
    </div>
</div>

<style is:global>
    .map-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
    }
    .map-leaflet {
        flex: 1 1 auto;
        min-height: 220px;
        width: 100%;
        border-radius: 8px;
        overflow: hidden;
        background: var(--surface-muted);
    }
    /* theme the tiles (the site's --map-tile-filter already handles dark modes) */
    .map-leaflet .leaflet-tile {
        filter: var(--map-tile-filter);
    }
    .map-leaflet .leaflet-container {
        background: var(--surface-muted);
        font-family: inherit;
    }
    /* zoom controls in the site language */
    .map-leaflet .leaflet-bar {
        border: 1px solid var(--map-control-divider);
        box-shadow: var(--map-marker-shadow);
        border-radius: 6px;
        overflow: hidden;
    }
    .map-leaflet .leaflet-bar a {
        background: var(--map-control-bg);
        color: var(--text-muted);
        border-bottom: 1px solid var(--map-control-divider);
        width: 28px;
        height: 28px;
        line-height: 28px;
    }
    .map-leaflet .leaflet-bar a:hover,
    .map-leaflet .leaflet-bar a:focus {
        background: var(--map-control-bg-hover);
        color: var(--text-heading);
    }
    .map-leaflet .leaflet-bar a.leaflet-disabled {
        background: var(--map-control-bg);
        color: var(--text-faint);
    }
    .map-leaflet .leaflet-control-attribution {
        background: var(--map-attribution-bg);
        color: var(--text-faint);
        font-size: 9px;
        backdrop-filter: blur(4px);
    }
    .map-leaflet .leaflet-control-attribution a {
        color: var(--text-subtle);
    }
    /* pin marker (same look as before) */
    .map-pin {
        position: relative;
        width: 26px;
        height: 26px;
        border-radius: 50% 50% 50% 0;
        background: var(--map-marker-bg);
        border: 3px solid var(--map-marker-muted-bg);
        transform: rotate(-45deg);
        box-shadow: var(--map-marker-shadow);
    }
    .map-pin::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--text-danger);
        transform: translate(-50%, -50%);
    }
</style>

<script>
    import L from "leaflet";

    const el = document.querySelector("[data-map]");
    if (el) {
        const vichy = [46.1271, 3.4261];
        const map = L.map(el, {
            center: vichy,
            zoom: 15,
            minZoom: 3,
            maxZoom: 19,
            scrollWheelZoom: false,
            zoomControl: true,
            attributionControl: true,
        });
        L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png", {
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: "abcd",
            maxZoom: 20,
        }).addTo(map);

        const pin = L.divIcon({
            className: "",
            html: '<span class="map-pin"></span>',
            iconSize: [26, 26],
            iconAnchor: [13, 26],
        });
        L.marker(vichy, { icon: pin, title: "Vichy" }).addTo(map);
    }
</script>
