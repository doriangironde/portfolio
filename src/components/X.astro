                    _ngcontent-ng-c1358294111=""
                    class="activity-copy"
                >
                    <span
                        _ngcontent-ng-c1358294111=""
                        class="activity-title"
                    >
                        @{handle}
                    </span
                    ><span
                        _ngcontent-ng-c1358294111=""
                        class="activity-detail"
                    >
                        Founder of Nero · Vichy
                    </span>
                </div>
            </div>
        </div>
    </section>
