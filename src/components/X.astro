---
const handle = "0xdioxus";
---

<a
    _ngcontent-ng-c1358294111=""
    class="x-card"
    href={`https://x.com/${handle}`}
    target="_blank"
    rel="noopener noreferrer"
    style="text-decoration: none;"
>
    <section _ngcontent-ng-c1358294111="" class="discord-card">
        <div
            _ngcontent-ng-c1358294111=""
            class="section-header"
        >
            <img
                _ngcontent-ng-c1358294111=""
                src="/icons/x.svg"
                alt="X Icon"
                class="section-icon"
            /><h2
                _ngcontent-ng-c1358294111=""
                class="section-title"
            >
                X
            </h2>
        </div>
        <div _ngcontent-ng-c1358294111="" class="profile-main">
            <div _ngcontent-ng-c1358294111="" class="avatar-wrap">
                <img
                    _ngcontent-ng-c1358294111=""
                    class="avatar"
                    src="/doriangironde-favicon.svg"
                    alt="Dorian Gironde"
                />
            </div>
            <div _ngcontent-ng-c1358294111="" class="profile-copy">
                <div
                    _ngcontent-ng-c1358294111=""
                    class="identity-row"
                >
                    <h3
                        _ngcontent-ng-c1358294111=""
                        class="display-name"
