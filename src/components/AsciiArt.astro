---

---

<div class="app-ascii-art">
    <div class="ascii-art-card">
        <div class="ascii-art-canvas-wrap">
            <canvas class="ascii-art-canvas" aria-hidden="true"></canvas>
        </div>
    </div>
</div>

<script>
    (() => {
        const wrap = document.querySelector(".ascii-art-canvas-wrap");
        if (!wrap) return;
        const canvas = wrap.querySelector("canvas");
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        const N_SURFACE = 640;
        const N_ORBIT = 12;
        const N_DISTANT = 26;
        const N_DRIFT = 6;

        let W = 0,
            H = 0,
            dpr = 1;
        let ACC = [86, 159, 140];
        let surface = [],
            orbiters = [],
            distant = [];
        let t = 0,
            lastTs = 0,
            running = false,
            dt = 0.016;
        let hover = 0,
            hoverTarget = 0;
        let glowGrad = null;

        const rnd = (() => {
            let s = 0x9e3779b9;
            return () => {
                s |= 0;
                s = (s + 0x6d2b79f5) | 0;
                let r = Math.imul(s ^ (s >>> 15), 1 | s);
                r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;
                return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
            };
        })();

        function readDorian() {
            const cs = getComputedStyle(document.documentElement);
            let v = cs.getPropertyValue("--text-danger-strong").trim();
            if (!v) v = cs.getPropertyValue("--text-info").trim();
            let m = v.match(/#([0-9a-f]{6})/i);
            if (m)
                return [
                    parseInt(m[1].slice(0, 2), 16),
                    parseInt(m[1].slice(2, 4), 16),
                    parseInt(m[1].slice(4, 6), 16),
                ];
            m = v.match(/rgba?\\(([^)]+)\\)/);
            if (m) {
                const p = m[1].split(",").map((s) => parseFloat(s));
                return [p[0], p[1], p[2]];
            }
            return [214, 69, 69];
        }

        const randUnit = () => {
            const th = rnd() * 6.2832,
                ph = Math.acos(2 * rnd() - 1);
            return [
                Math.sin(ph) * Math.cos(th),
                Math.cos(ph),
                Math.sin(ph) * Math.sin(th),
            ];
        };

        const smooth = (x) => {
            const e = x < 0 ? 0 : x > 1 ? 1 : x;
            return e * e * (3 - 2 * e);
        };

        function build() {
            surface = [];
            const ga = Math.PI * (3 - Math.sqrt(5));
            for (let i = 0; i < N_SURFACE; i++) {
                const y = 1 - (2 * (i + 0.5)) / N_SURFACE;
                const rad = Math.sqrt(Math.max(0, 1 - y * y));
                const th = i * ga;
                let x = rad * Math.cos(th),
                    z = rad * Math.sin(th);
                const p = 0.05;
                x += p * Math.sin(y * 5.1 + i * 0.31) * Math.cos(th * 3.1 + i * 0.13);
                z += p * Math.cos(y * 4.3 + i * 0.53) * Math.sin(th * 2.7 + i * 0.21);
                const yy = y + p * Math.sin(y * 3.7 + i * 0.7);
                const len = Math.hypot(x, yy, z) || 1;
                const energy = i % 46 === 0;
                surface.push({
                    bx: x / len,
                    by: yy / len,
                    bz: z / len,
                    rJ: 1 + (rnd() - 0.5) * 0.12,
                    ph: rnd() * 6.28,
                    sizeJ: 0.72 + rnd() * 0.5,
                    energy,
                    eAxis: energy ? randUnit() : null,
                    eSpeed: energy ? 0.03 + rnd() * 0.05 : 0,
                    drift:
                        i % Math.floor(N_SURFACE / N_DRIFT) === 0
                            ? { mode: "idle", timer: 14 + rnd() * 26, prog: 0 }
                            : null,
                });
            }

            orbiters = [];
            for (let i = 0; i < N_ORBIT; i++) {
                const axis = randUnit();
                let ref = randUnit();
                const dot = ref[0] * axis[0] + ref[1] * axis[1] + ref[2] * axis[2];
                ref = [ref[0] - axis[0] * dot, ref[1] - axis[1] * dot, ref[2] - axis[2] * dot];
                const rl = Math.hypot(...ref) || 1;
                ref = [ref[0] / rl, ref[1] / rl, ref[2] / rl];
                const w = [
                    axis[1] * ref[2] - axis[2] * ref[1],
                    axis[2] * ref[0] - axis[0] * ref[2],
                    axis[0] * ref[1] - axis[1] * ref[0],
                ];
                orbiters.push({
                    axis,
                    ref,
                    w,
                    c: ref[0] * axis[0] + ref[1] * axis[1] + ref[2] * axis[2],
                    speed: (rnd() < 0.5 ? -1 : 1) * (0.035 + rnd() * 0.06),
                    ph: rnd() * 6.28,
                    rad: 1.12 + rnd() * 0.16,
                });
            }

            distant = [];
            for (let i = 0; i < N_DISTANT; i++) {
                distant.push({
                    x: 0.5 + (rnd() - 0.5) * 1.55,
                    y: 0.47 + (rnd() - 0.5) * 1.45,
                    tw: 0.1 + rnd() * 0.4,
                    ph: rnd() * 6.28,
                });
            }
        }

        function resize() {
            W = wrap.clientWidth;
            H = wrap.clientHeight;
            if (W < 40 || H < 40) return;
            dpr = Math.min(2, window.devicePixelRatio || 1);
            canvas.width = W * dpr;
            canvas.height = H * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ACC = readDorian();
            if (!surface.length) build();
            glowGrad = null;
            drawFrame();
            if (!reduced && !running) {
                running = true;
                lastTs = performance.now();
                requestAnimationFrame(frame);
            }
        }

        const F = 3.0;
        const LIGHT = [-0.36, -0.72, 0.55];
        const DARK_MODE = () =>
            document.documentElement.dataset.colorScheme === "dark";

        function particleColor(shade) {
            const a = ACC;
            const lit = [a[0] * 0.84, a[1] * 0.84, a[2] * 0.84];
            const bg = DARK_MODE() ? [12, 12, 14] : [255, 255, 255];
            const unlit = [
                a[0] * 0.5 + bg[0] * 0.5,
                a[1] * 0.5 + bg[1] * 0.5,
                a[2] * 0.5 + bg[2] * 0.5,
            ];
            const s = Math.min(1, Math.max(0, shade));
            const r = lit[0] + (unlit[0] - lit[0]) * s;
            const g = lit[1] + (unlit[1] - lit[1]) * s;
            const b = lit[2] + (unlit[2] - lit[2]) * s;
            return `rgb(${r | 0},${g | 0},${b | 0})`;
        }

        function drawFrame() {
            ctx.clearRect(0, 0, W, H);

            const h = smooth(hover);

            const RAD = Math.min(0.42 * Math.min(W, H * 0.86), 0.36 * W, 0.4 * H);
            const cx0 = W / 2,
                cy0 = H * 0.47;

            if (h > 0.01) {
                if (!glowGrad) {
                    const g = ctx.createRadialGradient(
                        cx0,
                        cy0,
                        RAD * 0.2,
                        cx0,
                        cy0,
                        RAD * 1.5,
                    );
                    g.addColorStop(0, `rgba(${ACC[0]},${ACC[1]},${ACC[2]},0.5)`);
                    g.addColorStop(1, `rgba(${ACC[0]},${ACC[1]},${ACC[2]},0)`);
                    glowGrad = g;
                }
                ctx.globalAlpha = 0.06 * h;
                ctx.fillStyle = glowGrad;
                ctx.beginPath();
                ctx.arc(cx0, cy0, RAD * 1.5, 0, 6.2832);
                ctx.fill();
                ctx.globalAlpha = 1;
            }

            for (const d of distant) {
                const a = 0.05 + 0.06 * (0.5 + 0.5 * Math.sin(t * d.tw + d.ph));
                ctx.globalAlpha = a;
                ctx.fillStyle = `rgb(${ACC[0]},${ACC[1]},${ACC[2]})`;
                const s = 1.3;
                ctx.fillRect(d.x * W - s / 2, d.y * H - s / 2, s, s);
            }
            ctx.globalAlpha = 1;

            const ry = t * (0.11 + 0.05 * h),
                cyr = Math.cos(ry),
                sy = Math.sin(ry);
            const rxp = 0.34 * Math.sin(t * 0.23),
                cxr = Math.cos(rxp),
                sxr = Math.sin(rxp);
            const rzp = 0.14 * Math.sin(t * 0.17 + 2),
                czr = Math.cos(rzp),
                szr = Math.sin(rzp);

            const brG = 1 + 0.03 * Math.sin(t * 0.42);

            for (const p of surface) {
                let x = p.bx * cyr + p.bz * sy;
                let z = -p.bx * sy + p.bz * cyr;
                let y = p.by * cxr - z * sxr;
                z = p.by * sxr + z * cxr;
                const x2 = x * czr + y * szr;
                y = -x * szr + y * czr;
                x = x2;

                if (p.energy) {
                    const [ax, ay, az] = p.eAxis;
                    const a = p.eSpeed * t;
                    const c = Math.cos(a),
                        s = Math.sin(a),
                        C = 1 - c;
                    const nx =
                        x * (c + ax * ax * C) +
                        y * (ax * ay * C - az * s) +
                        z * (ax * az * C + ay * s);
                    const ny =
                        x * (ay * ax * C + az * s) +
                        y * (c + ay * ay * C) +
                        z * (ay * az * C - ax * s);
                    z =
                        x * (az * ax * C - ay * s) +
                        y * (az * ay * C + ax * s) +
                        z * (c + az * az * C);
                    x = nx;
                    y = ny;
                }

                let rad =
                    brG *
                    (1 +
                        0.035 * Math.sin(t * 0.5 + p.ph) +
                        0.02 * Math.sin(t * 0.31 + p.ph * 1.7));

                const d = p.drift;
                if (d) {
                    d.timer -= dt;
                    if (d.mode === "idle" && d.timer <= 0) {
                        d.mode = "out";
                        d.prog = 0;
                    } else if (d.mode === "out") {
                        d.prog += dt / 5;
                        if (d.prog >= 1) {
                            d.mode = "hold";
                            d.prog = 0;
                        }
                    } else if (d.mode === "hold") {
                        d.prog += dt / 2.5;
                        if (d.prog >= 1) {
                            d.mode = "in";
                            d.prog = 0;
                        }
                    } else if (d.mode === "in") {
                        d.prog += dt / 6;
                        if (d.prog >= 1) {
                            d.mode = "idle";
                            d.timer = 18 + rnd() * 30;
                            d.prog = 1;
                        }
                    }
                    const env = smooth(d.prog);
                    rad *=
                        d.mode === "idle"
                            ? 1
                            : d.mode === "out"
                              ? 1 + 0.34 * env
                              : d.mode === "hold"
                                ? 1.34
                                : 1 + 0.34 * (1 - env);
                }

                const scale = F / (F - z * rad * 0.95);
                const sx = cx0 + x * rad * RAD * scale;
                const sy2 = cy0 + y * rad * RAD * scale;

                const depth = (z * rad + 1.35) / 2.7;
                const alpha = 0.26 + 0.66 * Math.min(1, Math.max(0, depth));

                const L = x * LIGHT[0] + y * LIGHT[1] + z * LIGHT[2];
                const shade = Math.min(1, Math.max(0, (1 - L) / 0.75)) * 0.8;
                const size = 1.7 * scale * (0.72 + 0.5 * depth) * p.sizeJ;

                if (p.energy) {
                    const pulse = 0.55 + 0.4 * (0.5 + 0.5 * Math.sin(t * 1.15 + p.ph));
                    ctx.globalAlpha = alpha * pulse * 0.12;
                    ctx.fillStyle = `rgb(${ACC[0]},${ACC[1]},${ACC[2]})`;
                    ctx.beginPath();
                    ctx.arc(sx, sy2, size * 4.5, 0, 6.2832);
                    ctx.fill();
                    ctx.globalAlpha = Math.min(1, alpha * pulse);
                    ctx.beginPath();
                    ctx.arc(sx, sy2, size * 1.5, 0, 6.2832);
                    ctx.fill();
                } else {
                    ctx.globalAlpha = alpha;
                    ctx.fillStyle = particleColor(shade);
                    ctx.beginPath();
                    ctx.arc(sx, sy2, size, 0, 6.2832);
                    ctx.fill();
                }
            }
            ctx.globalAlpha = 1;

            for (const o of orbiters) {
                const a = t * o.speed + o.ph;
                const c = Math.cos(a),
                    s = Math.sin(a),
                    C = 1 - c;
                let x = o.ref[0] * c + o.w[0] * s + o.axis[0] * o.c * C;
                let y = o.ref[1] * c + o.w[1] * s + o.axis[1] * o.c * C;
                const z = o.ref[2] * c + o.w[2] * s + o.axis[2] * o.c * C;
                const x1 = x * cyr + z * sy;
                const z1 = -x * sy + z * cyr;
                x = x1;
                const y1 = y * cxr - z1 * sxr;
                const z2 = y * sxr + z1 * cxr;
                y = y1;
                const x2 = x * czr + y * szr;
                y = -x * szr + y * czr;
                x = x2;

                const rad = o.rad;
                const scale = F / (F - z2 * rad * 0.95);
                const sx = cx0 + x * rad * RAD * scale;
                const sy2 = cy0 + y * rad * RAD * scale;
                const depth = (z2 * rad + 1.35) / 2.7;
                const alpha = 0.3 + 0.45 * Math.min(1, Math.max(0, depth));
                ctx.globalAlpha = alpha;
                ctx.fillStyle = `rgb(${ACC[0]},${ACC[1]},${ACC[2]})`;
                ctx.beginPath();
                ctx.arc(sx, sy2, 1.9 * scale, 0, 6.2832);
                ctx.fill();
            }
            ctx.globalAlpha = 1;
        }

        function frame(ts) {
            const d = Math.max(0, Math.min(0.05, (ts - lastTs) / 1000 || 0.016));
            lastTs = ts;
            t += d;
            dt = d;
            hover += (hoverTarget - hover) * Math.min(1, dt * 3.5);
            try {
                drawFrame();
            } catch (e) {
                console.error("particle-sphere:", e);
            }
            requestAnimationFrame(frame);
        }

        if (!reduced) {
            wrap.addEventListener("mouseenter", () => {
                hoverTarget = 1;
            });
            wrap.addEventListener("mouseleave", () => {
                hoverTarget = 0;
            });
        }

        const ro = new ResizeObserver(() => {
            clearTimeout(ro._t);
            ro._t = setTimeout(resize, 120);
        });
        ro.observe(wrap);
        resize();
    })();
</script>
