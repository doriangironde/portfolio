---

---

<div class="app-ascii-art">
    <div class="ascii-art-card">
        <div class="ascii-art-canvas-wrap">
            <canvas class="ascii-art-canvas" aria-hidden="true"></canvas>
        </div>
    </div>
</div>

<script>
    (() => {
        const wrap = document.querySelector(".ascii-art-canvas-wrap");
        if (!wrap) return;
        const canvas = wrap.querySelector("canvas");
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        const FONT =
            '"SF Mono", ui-monospace, Menlo, Consolas, "Liberation Mono", monospace';

        const N = 16; // drifting particles — deliberately few

        let W = 0,
            H = 0,
            dpr = 1,
            cols = 0,
            rows = 0,
            pitch = 0,
            fsize = 0;
        let pal = [];
        let base = null,
            bctx = null;
        let particles = [];
        let breathDust = [];
        let t = 0,
            lastTs = 0,
            running = false,
            dt = 0.016;

        function palette() {
            const dark =
                document.documentElement.dataset.colorScheme === "dark";
            if (dark)
                return [
                    "#4E5D58",
                    "#93A49E",
                    "#C9D8D3",
                    "#EAF4F1",
                    "#4E8A77",
                    "#7FC9B3",
                ];
            return [
                "#98A8A2",
                "#55645F",
                "#242D2A",
                "#162F29",
                "#295B4F",
                "#569F8C",
            ];
        }

        const R = (() => {
            let s = 0x9e3779b9;
            return () => {
                s |= 0;
                s = (s + 0x6d2b79f5) | 0;
                let r = Math.imul(s ^ (s >>> 15), 1 | s);
                r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;
                return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
            };
        })();

        function spawnParticle(atStart) {
            return {
                x: 0.08 + R() * 0.84,
                y: atStart ? 0.1 + R() * 0.8 : 1.05 + R() * 0.08,
                vy: 0.006 + R() * 0.013,
                vx: (R() - 0.5) * 0.01,
                swayA: 0.012 + R() * 0.028,
                swayF: 0.25 + R() * 0.8,
                ph: R() * 6.28,
                life: 15 + R() * 15,
                age: 0,
                green: R() < 0.22,
                bright: R() < 0.25,
            };
        }

        function buildBase() {
            // a few very faint dots so the space feels intentional
            for (let y = 0; y < rows; y++)
                for (let x = 0; x < cols; x++) {
                    const h = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453;
                    if (h - Math.floor(h) > 0.006) continue;
                    bctx.fillStyle = pal[0];
                    bctx.globalAlpha = 0.4;
                    bctx.fillText("·", x * pitch + pitch / 2, y * fsize + fsize * 0.5);
                }
            bctx.globalAlpha = 1;
            breathDust = [];
            for (let i = 0; i < 12; i++) {
                breathDust.push({
                    x: 0.05 + R() * 0.9,
                    y: 0.05 + R() * 0.9,
                    ph: R() * 6.28,
                });
            }
        }

        function resize() {
            W = wrap.clientWidth;
            H = wrap.clientHeight;
            if (W < 40 || H < 40) return;
            dpr = Math.min(2, window.devicePixelRatio || 1);
            fsize = clamp(W / 38, 11, 14);
            ctx.font = `${fsize}px ${FONT}`;
            try {
                ctx.letterSpacing = "0px";
            } catch {}
            pitch = ctx.measureText("0").width || fsize * 0.6;
            cols = Math.max(20, Math.floor(W / pitch));
            rows = Math.max(20, Math.floor(H / fsize));
            canvas.width = W * dpr;
            canvas.height = H * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.textBaseline = "middle";
            base = document.createElement("canvas");
            base.width = W * dpr;
            base.height = H * dpr;
            bctx = base.getContext("2d");
            bctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            bctx.font = ctx.font;
            bctx.textBaseline = "middle";
            pal = palette();

            buildBase();

            if (!particles.length) {
                for (let i = 0; i < N; i++) particles.push(spawnParticle(true));
            }

            ctx.drawImage(base, 0, 0, W, H);
            drawFrame();
            if (!reduced && !running) {
                running = true;
                lastTs = performance.now();
                requestAnimationFrame(frame);
            }
        }

        const clamp = (v, a, b) => Math.min(b, Math.max(a, v));

        function drawFrame() {
            ctx.drawImage(base, 0, 0, W, H);
            const px = (u) => u * cols * pitch + pitch / 2;
            const py = (v) => v * rows * fsize + fsize * 0.5;

            // breathing dust
            for (const d of breathDust) {
                ctx.globalAlpha = 0.12 + 0.3 * (0.5 + 0.5 * Math.sin(t * 0.4 + d.ph));
                ctx.fillStyle = pal[0];
                ctx.fillText("·", px(d.x), py(d.y));
            }
            ctx.globalAlpha = 1;

            // drifting particles
            for (let i = 0; i < particles.length; i++) {
                const p = particles[i];
                p.age += dt;
                if (p.age > p.life) {
                    particles[i] = spawnParticle(false);
                    continue;
                }
                p.y -= p.vy * dt;
                p.x += (p.vx + p.swayA * Math.sin(t * p.swayF + p.ph)) * dt;
                if (p.y < -0.06) particles[i] = spawnParticle(false);
            }
            for (const p of particles) {
                const a = Math.sin(Math.PI * Math.min(1, p.age / p.life));
                if (a <= 0.02) continue;
                ctx.globalAlpha = 0.9 * a;
                if (p.green) {
                    ctx.fillStyle = p.bright ? pal[5] : pal[4];
                    ctx.fillText(
                        "·°+·*"[((p.age * 1.1) | 0) % 5],
                        px(p.x),
                        py(p.y),
                    );
                } else {
                    ctx.fillStyle = p.bright ? pal[2] : pal[1];
                    ctx.fillText(
                        "·°··+·"[((p.age * 1.3) | 0) % 6],
                        px(p.x),
                        py(p.y),
                    );
                }
            }
            ctx.globalAlpha = 1;
        }

        function frame(ts) {
            const d = Math.max(0, Math.min(0.05, (ts - lastTs) / 1000 || 0.016));
            lastTs = ts;
            t += d;
            dt = d;
            try {
                drawFrame();
            } catch (e) {
                console.error("ascii-art:", e);
            }
            requestAnimationFrame(frame);
        }

        const ro = new ResizeObserver(() => {
            clearTimeout(ro._t);
            ro._t = setTimeout(resize, 120);
        });
        ro.observe(wrap);
        resize();
    })();
</script>
