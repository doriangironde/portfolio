---

---

<div class="app-ascii-art">
    <div class="ascii-art-card">
        <div class="ascii-art-canvas-wrap">
            <canvas class="ascii-art-canvas" aria-hidden="true"></canvas>
        </div>
    </div>
</div>

<script>
    (() => {
        const wrap = document.querySelector(".ascii-art-canvas-wrap");
        if (!wrap) return;
        const canvas = wrap.querySelector("canvas");
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        const FONT =
            '"SF Mono", ui-monospace, Menlo, Consolas, "Liberation Mono", monospace';

        /* ---------------------------------------------------------------
           ONE shape: a ribbon of characters that rises, loops at the top
           and crosses itself — density forms the silhouette.
        --------------------------------------------------------------- */
        const CP = [
            [0.26, 0.94],
            [0.4, 0.76],
            [0.5, 0.52],
            [0.64, 0.34],
            [0.7, 0.18],
            [0.52, 0.07],
            [0.33, 0.13],
            [0.25, 0.3],
            [0.33, 0.42],
            [0.5, 0.52],
            [0.56, 0.7],
            [0.62, 0.84],
            [0.7, 0.94],
        ];
        const FRONT_T = 0.6; // the descending pass is the front layer
        const WMAX = 0.095; // ribbon half-width (normalized)

        let W = 0,
            H = 0,
            dpr = 1,
            cols = 0,
            rows = 0,
            pitch = 0,
            fsize = 0;
        let pal = [];
        let base = null,
            bctx = null;
        let curve = []; // {u,v,t,w,tx,ty,front} sampled centerline
        let cands = []; // per cell: candidate sample indices
        let dust = [],
            breathDust = [];
        let particles = [];
        let t = 0,
            lastTs = 0,
            running = false,
            spawnAcc = 0,
            dt = 0.016;

        function palette() {
            const dark =
                document.documentElement.dataset.colorScheme === "dark";
            if (dark)
                return [
                    "#4E5D58",
                    "#93A49E",
                    "#C9D8D3",
                    "#EAF4F1",
                    "#4E8A77",
                    "#7FC9B3",
                ];
            return [
                "#98A8A2",
                "#55645F",
                "#242D2A",
                "#162F29",
                "#295B4F",
                "#569F8C",
            ];
        }

        const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
        const hash = (x, y) => {
            const s = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453;
            return s - Math.floor(s);
        };
        const R = (() => {
            let s = 0x9e3779b9;
            return () => {
                s |= 0;
                s = (s + 0x6d2b79f5) | 0;
                let r = Math.imul(s ^ (s >>> 15), 1 | s);
                r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;
                return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
            };
        })();

        function buildCurve() {
            curve = [];
            const n = CP.length;
            const N = 190;
            for (let i = 0; i < N; i++) {
                const tt = (i / (N - 1)) * (n - 1);
                const i0 = Math.floor(tt);
                const f = tt - i0;
                const p0 = CP[Math.max(0, i0 - 1)],
                    p1 = CP[i0],
                    p2 = CP[Math.min(n - 1, i0 + 1)],
                    p3 = CP[Math.min(n - 1, i0 + 2)];
                const u =
                    0.5 *
                    (2 * p1[0] +
                        (-p0[0] + p2[0]) * f +
                        (2 * p0[0] - 5 * p1[0] + 4 * p2[0] - p3[0]) * f * f +
                        (-p0[0] + 3 * p1[0] - 3 * p2[0] + p3[0]) * f * f * f);
                const v =
                    0.5 *
                    (2 * p1[1] +
                        (-p0[1] + p2[1]) * f +
                        (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * f * f +
                        (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * f * f * f);
                const tn = i / (N - 1);
                const taper = Math.pow(
                    Math.sin(
                        Math.PI * clamp((tn - 0.05) / 0.9, 0, 1),
                    ),
                    1.15,
                );
                const w =
                    WMAX *
                    (0.32 + 0.68 * taper) *
                    (0.93 + 0.07 * Math.sin(tn * 22 + 1.7));
                curve.push({ u, v, t: tn, w, front: tn >= FRONT_T });
            }
            // tangents for particle direction
            for (let i = 0; i < curve.length; i++) {
                const a = curve[Math.max(0, i - 1)];
                const b = curve[Math.min(curve.length - 1, i + 1)];
                const dx = b.u - a.u,
                    dy = b.v - a.v;
                const len = Math.hypot(dx, dy) || 1;
                curve[i].tx = dx / len;
                curve[i].ty = dy / len;
            }
        }

        function buildDust() {
            dust = [];
            for (let y = 0; y < rows; y++)
                for (let x = 0; x < cols; x++) {
                    if (hash(x, y) > 0.009) continue;
                    const ch = ".·:;"[(hash(x + 3.7, y + 9.2) * 4) | 0];
                    const ci = hash(x, y + 1.3) < 0.4 ? 0 : 1;
                    bctx.fillStyle = pal[ci];
                    bctx.globalAlpha = 0.45;
                    bctx.fillText(ch, x * pitch + pitch / 2, y * fsize + fsize * 0.5);
                }
            bctx.globalAlpha = 1;
            breathDust = [];
            for (let i = 0; i < 20 && dust.length; i++) {
                const d = dust[(R() * dust.length) | 0];
                if (d) breathDust.push({ x: d.x, y: d.y, ph: R() * 6.28 });
            }
        }

        function resize() {
            W = wrap.clientWidth;
            H = wrap.clientHeight;
            if (W < 40 || H < 40) return;
            dpr = Math.min(2, window.devicePixelRatio || 1);
            fsize = clamp(W / 40, 10, 13.5);
            ctx.font = `${fsize}px ${FONT}`;
            try {
                ctx.letterSpacing = "0px";
            } catch {}
            pitch = ctx.measureText("0").width || fsize * 0.6;
            cols = Math.max(20, Math.floor(W / pitch));
            rows = Math.max(20, Math.floor(H / fsize));
            canvas.width = W * dpr;
            canvas.height = H * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.textBaseline = "middle";
            base = document.createElement("canvas");
            base.width = W * dpr;
            base.height = H * dpr;
            bctx = base.getContext("2d");
            bctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            bctx.font = ctx.font;
            bctx.textBaseline = "middle";
            pal = palette();

            buildCurve();
            buildDust();

            // candidate samples per cell (windowed by distance)
            const maxR = WMAX * 1.3 * cols + 0.03 * cols + 2;
            cands = [];
            for (let y = 0; y < rows; y++) {
                for (let x = 0; x < cols; x++) {
                    const list = [];
                    for (let si = 0; si < curve.length; si++) {
                        const s = curve[si];
                        if (
                            Math.abs(x - s.u * cols) > maxR ||
                            Math.abs(y - s.v * rows) > maxR
                        )
                            continue;
                        list.push(si);
                    }
                    cands.push(list);
                }
            }

            ctx.drawImage(base, 0, 0, W, H);
            drawFrame();
            if (!reduced && !running) {
                running = true;
                lastTs = performance.now();
                requestAnimationFrame(frame);
            }
        }

        /* ------------------------------- rendering ------------------------------ */

        const TIERS = [
            { r: 0.16, p: 0.85, ch: ["#", "@", "%", "&"], ci: [3, 3, 2, 4], a: 1 },
            { r: 0.42, p: 0.6, ch: ["*", "+", ":", "·"], ci: [2, 2, 1, 1], a: 0.95 },
            { r: 0.72, p: 0.32, ch: ["·", ".", ":"], ci: [1, 0, 0], a: 0.85 },
            { r: 1.0, p: 0.13, ch: ["░", "·", "."], ci: [0, 0, 0], a: 0.7 },
            { r: 1.22, p: 0.06, ch: ["·", "."], ci: [0], a: 0.5 },
        ];

        function drawFrame() {
            // ripple displacement + breathing width, per sample
            const n = curve.length;
            const su = new Float32Array(n);
            const sw = new Float32Array(n);
            for (let i = 0; i < n; i++) {
                const s = curve[i];
                su[i] = s.u + 0.02 * Math.sin(s.t * 9.5 - t * 0.9);
                sw[i] = s.w * (1 + 0.13 * Math.sin(t * 0.55 + s.t * 4.2)) * cols;
            }

            ctx.drawImage(base, 0, 0, W, H);
            const fsize2 = fsize * 0.5;

            for (let y = 0; y < rows; y++) {
                for (let x = 0; x < cols; x++) {
                    const list = cands[y * cols + x];
                    if (!list || !list.length) continue;
                    let dF = Infinity,
                        dFw = 0,
                        dB = Infinity,
                        dBw = 0;
                    for (let k = 0; k < list.length; k++) {
                        const s = curve[list[k]];
                        const dx = x - su[list[k]] * cols;
                        const dy = y - s.v * rows;
                        const d2 = dx * dx + dy * dy;
                        if (s.front) {
                            if (d2 < dF) {
                                dF = d2;
                                dFw = sw[list[k]];
                            }
                        } else if (d2 < dB) {
                            dB = d2;
                            dBw = sw[list[k]];
                        }
                    }
                    const frontHere = dF <= dB;
                    const d = Math.min(dF, dB);
                    const wEff = frontHere ? dFw : dBw;
                    if (d === Infinity || !wEff) continue;
                    const r = Math.sqrt(d) / wEff;
                    if (r >= 1.22) continue;

                    let alpha = 1;
                    if (!frontHere && dF < 2.4 * wEff * 2.4 * wEff)
                        alpha = 0.38; // behind the front layer

                    // tier from distance
                    let tier = TIERS.length - 1;
                    for (let ti = 0; ti < TIERS.length; ti++) {
                        if (r < TIERS[ti].r) {
                            tier = ti;
                            break;
                        }
                    }
                    const T = TIERS[tier];
                    const h1 = hash(x, y);
                    const h2 = hash(x + 7.31, y + 13.7);

                    let p = T.p;
                    if (tier === 4) {
                        // edge haze slowly appears / dissolves
                        p *= 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(t * 0.9 + h1 * 6.28));
                    }
                    if (h2 > p) continue;

                    let idx = (h1 * T.ch.length) | 0;
                    // gentle shimmer: a few cells re-roll continuously
                    if ((x * 7 + y * 13 + Math.floor(t * 1.4)) % 41 === 0)
                        idx = (idx + 1) % T.ch.length;

                    ctx.globalAlpha = T.a * alpha;
                    ctx.fillStyle = pal[T.ci[idx]];
                    ctx.fillText(T.ch[idx], x * pitch + pitch / 2, y * fsize + fsize2);
                }
            }
            ctx.globalAlpha = 1;

            // energy thread flowing along the ribbon
            for (let i = 0; i < 20; i++) {
                const tn = (i / 20 + t * 0.018) % 1;
                const s = curve[Math.min(n - 1, Math.round(tn * (n - 1)))];
                const off = ((hash(i * 3.1, 1.7) * 2 - 1) * 0.35 * cols * WMAX) / 1;
                const x = s.u * cols + off * s.tx;
                const y = s.v * rows + off * s.ty;
                const ch = "+·*"[i % 3];
                ctx.globalAlpha = 0.55 + 0.3 * Math.sin(t * 1.6 + i * 1.9);
                ctx.fillStyle = pal[i % 2 ? 5 : 4];
                ctx.fillText(ch, x * pitch + pitch / 2, y * fsize + fsize2);
            }
            ctx.globalAlpha = 1;

            // small blooms where the light catches the fold
            const BT = [0.16, 0.47, 0.82];
            for (let i = 0; i < BT.length; i++) {
                const s = curve[Math.min(n - 1, Math.round(BT[i] * (n - 1)))];
                const cx = s.u * cols,
                    cy = s.v * rows;
                const pulse = 0.55 + 0.45 * Math.sin(t * 0.8 + i * 2.1);
                ctx.globalAlpha = 0.9 * pulse;
                ctx.fillStyle = pal[5];
                ctx.fillText("*", cx * pitch + pitch / 2, cy * fsize + fsize2);
                ctx.globalAlpha = 0.5 * pulse;
                ctx.fillStyle = pal[4];
                ctx.fillText("+", (cx - 1) * pitch + pitch / 2, cy * fsize + fsize2);
                ctx.fillText("+", (cx + 1) * pitch + pitch / 2, cy * fsize + fsize2);
                ctx.fillText("·", cx * pitch + pitch / 2, (cy - 1) * fsize + fsize2);
                ctx.fillText("·", cx * pitch + pitch / 2, (cy + 1) * fsize + fsize2);
            }
            ctx.globalAlpha = 1;

            // breathing dust in the empty space
            for (const d of breathDust) {
                ctx.globalAlpha =
                    0.2 + 0.3 * (0.5 + 0.5 * Math.sin(t * 0.5 + d.ph));
                ctx.fillStyle = pal[0];
                ctx.fillText("·", d.x * pitch + pitch / 2, d.y * fsize + fsize2);
            }
            ctx.globalAlpha = 1;

            // particles escaping the form
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.age += dt;
                p.off += p.speed * dt;
                p.vy += p.vdrift * dt;
                if (p.age > p.life) particles.splice(i, 1);
            }
            spawnAcc += dt;
            if (spawnAcc > 1.5 && particles.length < 10) {
                const tn = R();
                const s = curve[Math.min(n - 1, Math.round(tn * (n - 1)))];
                const side = R() < 0.5 ? -1 : 1;
                particles.push({
                    tn,
                    side,
                    off: (1.15 + R() * 0.8) * s.w * cols,
                    vy: 0.25 + R() * 0.3,
                    speed: 0.12 + R() * 0.22,
                    age: 0,
                    life: 8 + R() * 7,
                    green: R() < 0.35,
                });
                spawnAcc = 0;
            }
            for (const p of particles) {
                const s = curve[Math.min(n - 1, Math.round(p.tn * (n - 1)))];
                const px = s.u * cols + s.tx * p.off * p.side;
                const py = s.v * rows + s.ty * p.off * p.side - p.vy * p.age;
                const a = Math.sin(Math.PI * Math.min(1, p.age / p.life));
                if (px < -1 || px > cols + 1 || py < -1 || py > rows + 1) continue;
                ctx.globalAlpha = 0.75 * a;
                ctx.fillStyle = p.green ? pal[5] : pal[1];
                ctx.fillText(
                    "·+*"[((p.age * 1.2 + p.tn * 7) | 0) % 3],
                    px * pitch + pitch / 2,
                    py * fsize + fsize2,
                );
            }
            ctx.globalAlpha = 1;
        }

        function frame(ts) {
            const d = Math.max(0, Math.min(0.05, (ts - lastTs) / 1000 || 0.016));
            lastTs = ts;
            t += d;
            dt = d;
            try {
                drawFrame();
            } catch (e) {
                console.error("ascii-art:", e);
            }
            requestAnimationFrame(frame);
        }

        const ro = new ResizeObserver(() => {
            clearTimeout(ro._t);
            ro._t = setTimeout(resize, 120);
        });
        ro.observe(wrap);
        resize();
    })();
</script>
